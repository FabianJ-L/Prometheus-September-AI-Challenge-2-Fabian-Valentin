# ---------------------------------------------------------------------------
# NOESIS — root .gitignore
# ---------------------------------------------------------------------------

# Environment / secrets
.env
.env.*
!.env.example
*.local

# OS
.DS_Store
Thumbs.db

# Editors / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Python (backend)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version.local
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.uv/

# ---------------------------------------------------------------------------
# Node / Next.js (frontend)
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
coverage/

# ---------------------------------------------------------------------------
# Data / scratch
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
data/local/
scratch/
tmp/
