# ===========================================================================
# NOESIS — root environment template
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored.
#   cp .env.example .env
#
# The backend reads `backend/.env` (see backend/.env.example) and the frontend
# reads `frontend/.env.local` (see frontend/.env.example). This root file is a
# single place to keep shared values while developing locally.
# ===========================================================================

# --- Backend (run/trace sandbox) ------------------------------------------
NOESIS_ENV=development
NOESIS_HOST=127.0.0.1
NOESIS_PORT=8000
# Comma-separated origins allowed to call the API / open the WebSocket.
NOESIS_CORS_ORIGINS=http://localhost:3000

# Hard limits for the sandboxed code runner.
NOESIS_EXEC_TIMEOUT_SECONDS=5
NOESIS_EXEC_MAX_STEPS=2000

# --- Frontend (UI + chat/AI) ------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# AI provider (Anthropic) for the Socratic chat assistant — consumed by the
# frontend's `/api/chat` route handler, not by the backend. Get a key at
# https://console.anthropic.com/. Leave blank to run in MOCK mode (canned
# responses, no network calls).
ANTHROPIC_API_KEY=
NOESIS_AI_MODEL=claude-opus-5
# "adaptive" | "off" — thinking mode for the chat model.
NOESIS_AI_THINKING=adaptive
NOESIS_AI_MAX_TOKENS=4096
