# ===========================================================================
# NOESIS — root environment template
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored.
#   cp .env.example .env
#
# The backend reads `backend/.env` (see backend/.env.example) and the frontend
# reads `frontend/.env.local` (see frontend/.env.example). This root file is a
# single place to keep shared values while developing locally.
# ===========================================================================

# --- AI provider (frontend, Groq) -----------------------------------------
# The Socratic chat / annotation pipeline runs in the Next.js frontend (not
# the Python backend) — see frontend/src/app/api/ai/chat/route.ts. Get a key
# at https://console.groq.com/. Leave blank to run in MOCK mode (canned
# diagnostic responses, no network calls).
GROQ_API_KEY=

# Model + provider are swappable via config alone — see frontend/src/lib/ai/.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1

# --- Backend -------------------------------------------------------------
NOESIS_ENV=development
NOESIS_HOST=127.0.0.1
NOESIS_PORT=8000
# Comma-separated origins allowed to call the API / open the WebSocket.
NOESIS_CORS_ORIGINS=http://localhost:3000

# Hard limits for the sandboxed code runner.
NOESIS_EXEC_TIMEOUT_SECONDS=5
NOESIS_EXEC_MAX_STEPS=2000

# --- Frontend ----------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
