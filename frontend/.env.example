# NOESIS frontend — copy to `frontend/.env.local`
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# --- AI provider (Anthropic) for the Socratic chat assistant ---------------
# Server-side only (used by src/app/api/chat/route.ts) — never exposed to the
# browser. Leave blank to run in MOCK mode (canned responses, no network calls).
ANTHROPIC_API_KEY=
NOESIS_AI_MODEL=claude-opus-5
# "adaptive" | "off" — thinking mode for the chat model.
NOESIS_AI_THINKING=adaptive
NOESIS_AI_MAX_TOKENS=4096
