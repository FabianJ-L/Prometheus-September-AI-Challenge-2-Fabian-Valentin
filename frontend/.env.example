# NOESIS frontend — copy to `frontend/.env.local`
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# --- AI provider (Groq) -----------------------------------------------------
# The Socratic chat / annotation pipeline runs entirely here, in
# src/app/api/ai/chat/route.ts — the key stays server-side (no NEXT_PUBLIC_
# prefix), never shipped to the browser. Get a key at https://console.groq.com/.
# Leave blank to run in MOCK mode (canned diagnostics from the trace, no
# network calls).
GROQ_API_KEY=

# Model + provider are swappable via config alone — see src/lib/ai/provider.ts.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1
