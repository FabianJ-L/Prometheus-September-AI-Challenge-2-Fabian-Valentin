# NOESIS backend environment — copy to `backend/.env`
# All keys are optional; sane defaults are baked into app/config.py.
#
# This service only runs/traces Python code. Chat/AI lives in the frontend
# (see frontend/.env.example) — there is nothing AI-related to configure here.

# --- Server --------------------------------------------------------------
NOESIS_ENV=development
NOESIS_HOST=127.0.0.1
NOESIS_PORT=8000
NOESIS_CORS_ORIGINS=http://localhost:3000

# --- Sandboxed code runner --------------------------------------------------
NOESIS_EXEC_TIMEOUT_SECONDS=5
NOESIS_EXEC_MAX_STEPS=2000
